# Vacto frontend — environment variables (copy to .env.local for local dev,
# or set as Environment Variables in the Vercel project settings).

# Optional: a deployed Vacto contract address to load on first visit.
# Leave empty to load/paste contract addresses in the UI instead.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# GenLayer network to connect to (studio = free public testnet).
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999
NEXT_PUBLIC_GENLAYER_CHAIN_NAME=GenLayer Studio
NEXT_PUBLIC_GENLAYER_SYMBOL=GEN